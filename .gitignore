# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Documentation & Markdown Files ---
*.md

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Environment & Sensitive Credentials (SECURITY) ---
.env*
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.ca-bundle
*service-account*.json
*service_account*.json
*firebase-adminsdk*.json
*credentials*.json
*secret*
secrets/

# --- Next.js Build & Outputs ---
/.next/
/out/
/build
/dist
/.turbo
*.tsbuildinfo
next-env.d.ts

# --- PWA Service Worker Generated Outputs ---
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js
public/fallback-*.js.map
public/swe-worker-*.js

# --- Logs & Debug Output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
dev-server.log

# --- Testing & Coverage ---
/coverage
.nyc_output

# --- Genkit & AI Cache ---
.genkit/*

# --- Vercel & Hosting ---
.vercel

# --- IDE, Editor & OS Files ---
.vscode/
.idea/
.idx/
.kiro/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.modified
workspace/

# --- Firebase Rules ---
firestore.rules
storage.rules
